.main-navigation .main-nav li:hover .sub-menu {
    z-index: 100000;
}

.unclickable > a:hover {
  cursor: default;
}

/*
For mobile font size:14px
*/
@media (max-width: 768px) {
    body {
        font-size: 14px;
    }
}

/* title entry spacing */
.entry-title {
	 margin-top: 20px;
}

/*button color*/
.pt-cv-wrapper .btn-success, .vc_btn3.vc_btn3-color-vista-blue.vc_btn3-style-modern {
    border-color: #5b9372;
    background-color: #5b9372;
}

/*buttons color - hover*/
.pt-cv-wrapper .btn-success:hover, .vc_btn3.vc_btn3-color-vista-blue.vc_btn3-style-modern:hover {
    border-color: #76a489d1!important;
    background-color: #76a489d1!important;
}

/*accordions colors*/
.vc_tta-color-vista-blue.vc_tta-style-modern .vc_tta-panel .vc_tta-panel-heading, .vc_tta-color-vista-blue.vc_tta-style-modern .vc_tta-panel.vc_active .vc_tta-panel-title>a,.vc_tta-color-vista-blue.vc_tta-style-classic .vc_tta-panel .vc_tta-panel-heading {
    border-color: #5b9372!important;
    background-color: #5b9372!important;
	color:white!important;
}

.vc_tta-color-vista-blue.vc_tta-style-modern .vc_active .vc_tta-panel-heading .vc_tta-controls-icon::before {
    border-color: #fff!important;
}

.orange{
	color:#f7ac5a;
}

.green{
	color:#5a9271;
}

.services h3{
	text-align:center;
	font-size:16px!important;
	letter-spacing:-1.2px;
	line-height:2;
}

.first{
	background-color:orange;
	padding:5px 20px;
	color:white;
	font-weight:700;
	border-left:4px #5a9271 solid;
background: linear-gradient(to right, white 10px, #f9b263ed 1px);}

.second{
	background-color:#fafdfea8;
		padding:5px 10px;
}

.vc_btn3.vc_btn3-color-success.vc_btn3-style-flat{
	background-color:#5a9271;
}

.vc_btn3.vc_btn3-color-success.vc_btn3-style-flat:hover{
	background-color:#5a9271e8;
}

img.pt-cv-thumbnail {
    height: 270px;
		padding-bottom:10px;
}

a._self.pt-cv-readmore.btn.btn-success {
	background-color:#5a9271;
}

.pt-cv-title a{
	color:black!important;
	font-weight:700;
}

/*form fields width*/
input.wpcf7-form-control.wpcf7-text.wpcf7-validates-as-required {
    width: 100%;
		margin-top:3px;
}

h1 .first, h1 .second{
	font-size: 34px!important;
	padding: 10px 25px;
}


h1 .page-headings{
	font-size:35px;
	background-color:orange;
	padding:15px 35px 15px 35px;
	color:white;
	font-weight:700;
	border-left:4px #5a9271 solid;
background: linear-gradient(to right, white 10px, #f9b263ed 1px);
}

@media only screen and (max-width: 600px) {
  h1 .page-headings{
	font-size:19px;
	background-color:orange;
	padding:5px 8px 5px 15px;
	color:white;
	font-weight:400;
	letter-spacing:-1px;
	border-left:4px #5a9271 solid;
background: linear-gradient(to right, white 7px, #f9b263ed 1px);
}
}

h3 .page-headings{
	font-size:17px;
	background-color:orange;
	padding:10px 15px 10px 20px;
	color:white;
	font-weight:400;
	border-left:4px #5a9271 solid;
background: linear-gradient(to right, white 10px, #f9b263ed 1px);
}

/*post spacing on top*/
.single-post .site-content {
    margin-top: 50px;
}

/*post titles*/
h2.entry-title {
    line-height: 1.1;
    font-size: 25px;
}
